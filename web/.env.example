# Copy to .env.local and fill in. Never commit .env.local.
#
# Where the browser reaches the analysis API. In production it is served on this site's own
# origin under /api (Caddy routes it), so use exactly:
#   NEXT_PUBLIC_API_BASE_URL=/api
# Leave it empty to run the website without a backend (only the demonstration works).
# This value is public: it ends up in browser code. Never put a key or password here.
NEXT_PUBLIC_API_BASE_URL=

# Server-side only (never sent to browsers): how this Next.js server reaches the API to check
# sign-ins before showing /review. On the web server: http://127.0.0.1:8000
API_INTERNAL_URL=

# Development only: forward /api to a local backend when running `npm run dev`
# (start the API with: uvicorn rescrub.main:app --port 8000 --root-path /api).
# API_DEV_PROXY=http://127.0.0.1:8000

# Secrets such as DATABASE_URL and storage keys belong ONLY in backend/.env on the server.
