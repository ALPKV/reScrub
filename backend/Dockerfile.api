# Small image for the HTTP API (web server). The GPU worker uses ./Dockerfile.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY rescrub ./rescrub
COPY config ./config
COPY db ./db

RUN useradd --create-home --uid 1000 app && mkdir -p /app/data && chown -R app /app
USER app
EXPOSE 8000
# Only reachable through the host's Caddy (compose binds it to 127.0.0.1).
# Served at https://rescrub.health/api: Caddy strips /api, --root-path puts it back in links.
CMD ["uvicorn", "rescrub.main:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/api", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-server-header"]
