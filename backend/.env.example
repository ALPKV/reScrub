# Backend settings. Copy to .env on BOTH servers (web server: API; GPU server: worker).
# Never commit .env. chmod 600 .env.

# --- Tiger Cloud (TimescaleDB on PostgreSQL, by Tiger Data) ---
# Use the least-privilege user from db/app_role.sql, not tsdbadmin.
DATABASE_URL=postgres://rescrub_app:CHANGE_ME@CHANGE_ME.tsdb.cloud.timescale.com:CHANGE_PORT/tsdb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# --- Vultr Object Storage (shared by the API and the worker) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=rescrub-videos
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Delete each uploaded recording once its labeled video is saved (see the Privacy page).
DELETE_ORIGINAL_AFTER_PROCESSING=true

# --- API (web server) ---
# The website's origin(s). Used to refuse requests from other sites (CSRF) and for CORS.
CORS_ORIGINS=https://rescrub.health
# Sign-in: cookies are HTTPS-only; keep true in production.
COOKIE_SECURE=true
SESSION_HOURS=168
MAX_UPLOAD_MB=500
MAX_VIDEO_SEC=3600
UPLOADS_PER_HOUR_PER_CLIENT=10
REQUESTS_PER_MINUTE_PER_CLIENT=120

# --- Final review report (web server only) ---
# Google Gemini writes the report from finding text and reviewer decisions (never video).
# Create a key at https://aistudio.google.com. Leave empty to turn the feature off.
GEMINI_API_KEY=
# A model listed in Google AI Studio; "gemini-flash-latest" follows the newest Flash model.
GEMINI_MODEL=gemini-flash-latest
REPORTS_PER_HOUR_PER_USER=20

# --- Worker (GPU server) ---
DEVICE=auto
POSE_MODEL=yolo26m-pose.pt
ENABLE_HANDS=true
ENABLE_DEPTH=true
# After training on MM-OR (docs/DEPLOY.md, section 8), switch to the trained models:
# SURFACE_CONFIG=config/surfaces_mmor.yaml
# POSE_MODEL=trained/rescrub-or-pose.pt
# EMBED_MODEL=trained/rescrub-reid-cls.pt
# Optional: hand-drawn sterile/nonsterile zones for a fixed camera in your room.
# DEFAULT_ZONES_FILE=/app/config/room_zones.json

# Host folders mounted into the worker (docker-compose.yml).
MODELS_HOST_DIR=./models/trained
DATA_HOST_DIR=/mnt/data
